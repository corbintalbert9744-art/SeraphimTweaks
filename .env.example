# Seraphim Analytics environment example
# Copy to .env locally. Never commit secrets.

# Postgres (Drizzle) — required for `npm run db:push`
# Without DATABASE_URL the app uses an in-memory membership store (dev only).
DATABASE_URL=postgresql://user:pass@localhost:5432/seraphim_analytics

# Optional: The Odds API (or compatible) for live sportsbook prices
# Without this key, NBA featured props use model placeholder odds (-110/-110)
ODDS_API_KEY=

# Server
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
SESSION_SECRET=replace-with-a-long-random-string

# Stripe Checkout (subscriptions)
# Create Products/Prices in Stripe Dashboard, then paste Price IDs here.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STANDARD_MONTHLY=price_...
STRIPE_PRICE_STANDARD_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
