# Seraphim Analytics environment example
# Copy to .env locally. Never commit secrets.

# Postgres — REQUIRED in production (users, membership, sessions).
# Dev without DATABASE_URL falls back to in-memory membership/sessions (lost on restart).
# Local: npm run db:up  then  npm run db:push
# Production refuses to start without DATABASE_URL + a real SESSION_SECRET.
DATABASE_URL=postgresql://seraphim:seraphim@localhost:5432/seraphim_analytics

# Python data platform
DATA_PLATFORM_URL=http://127.0.0.1:8000
DATA_PLATFORM_PROXY=1
ENABLE_SCHEDULER=true
# Bootstrap ESPN → warehouse on API start (games/players/logs/injuries/props)
BOOTSTRAP_NBA_SYNC=true
# Full NBA slate sync interval (minutes)
NBA_SYNC_MINUTES=60
NBA_SYNC_MAX_GAMES=8
NBA_SYNC_PER_TEAM=3

# Optional: multi-provider market lines (priority merge + scheduled cache)
# Set ANY of these for pick'em boards — PropLine is tried first; on 429 / empty
# the sync short-circuits to SharpAPI then The Odds API (us_dfs PrizePicks/Underdog).
# Multiple keys avoid one free-tier daily limit blanking every board.
PROPLINE_API_KEY=
SHARPAPI_API_KEY=
ODDS_API_KEY=
ANTELYTICS_API_KEY=
# Antelytics (antelytics.dev) — default host is backend.antehq.com
ANTELYTICS_BASE_URL=https://backend.antehq.com/v1
# Comma-separated priority (first wins on duplicate book/player/market/side)
LINE_PROVIDER_PRIORITY=propline,sharpapi,the-odds-api,antelytics

# Optional: Football-Data.org free tier (soccer schedules)
# Without this key, Soccer stays empty — we do not fabricate fixtures
FOOTBALL_DATA_API_KEY=

# Optional: bootstrap MLB/NHL/Soccer on data-platform start (can be slow)
BOOTSTRAP_MULTI_SPORT=false
# How often to refresh MLB/NHL/Soccer warehouse (hours)
MULTI_SPORT_SYNC_HOURS=6

# Server
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
SESSION_SECRET=replace-with-a-long-random-string

# Owner account (defaults in code; override if needed)
# OWNER_EMAIL=corbintalbert@icloud.com
# OWNER_PASSWORD=IamtheMaster1!
# OWNER_NAME=Corbin

# Stripe Checkout (subscriptions) — use live keys + webhook for production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STANDARD_MONTHLY=price_...
STRIPE_PRICE_STANDARD_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# Discord (private Pro picks channel invite)
VITE_DISCORD_INVITE_URL=https://discord.gg/zFZxh9RKdC

# Ops: always run app + data-platform together so boards stay populated
#   npm run dev:all     (local)
#   npm run start:all   (production after npm run build)
#   docker compose up --build   (Postgres + full stack)
# Health: GET /api/health  → dataPlatform.ok must be true
# Keep ENABLE_SCHEDULER=true and at least one of PROPLINE/SHARPAPI/ODDS_API/ANTELYTICS keys.
#
# Public deploy (Render):
#   1. Push this repo → https://dashboard.render.com → New → Blueprint
#   2. Select render.yaml — creates Postgres + Docker web service
#   3. Paste Stripe + PropLine/SharpAPI secrets when prompted
#   4. Stripe webhook → https://YOUR-SERVICE.onrender.com/api/stripe/webhook
# APP_URL can be omitted on Render (uses RENDER_EXTERNAL_URL).
